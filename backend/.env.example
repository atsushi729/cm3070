# Copy to backend/.env and adjust as needed.

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql+psycopg://sme:sme_dev_pw@localhost:5432/sme

# Redis / Celery broker + result backend
REDIS_URL=redis://localhost:6379/0

# Local AI runtime
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
WHISPER_MODEL=small            # tiny|base|small|medium  (contingency: tiny if too slow)
WHISPER_DEVICE=auto            # auto|cpu  (auto selects CPU for CTranslate2)
WHISPER_COMPUTE_TYPE=int8      # int8 for CPU

# App
APP_ENV=development
AUDIO_STORAGE_DIR=./data/audio

# Booking
BOOKING_DURATION_MIN=90        # default seating length; also the conflict window

# Google Calendar mirror (optional; off by default).
# Setup: create a Google Cloud service account, enable the Calendar API, download
# its JSON key, then share the target calendar with the service-account email
CALENDAR_SYNC_ENABLED=false
GOOGLE_CALENDAR_ID=            # e.g. xxx@group.calendar.google.com
GOOGLE_CREDENTIALS_PATH=       # e.g. ./secrets/service-account.json
CALENDAR_TIMEZONE=Asia/Tokyo

# Offline suggestion-quality evaluation only.
OPENAI_API_KEY=
LLM_EVAL_MODEL=gpt-4o
